const POSTS = [
  {id:"s7", date:"Lundi 12 octobre, 18h30", titre:"Le bouillon de Porc Noir offert - Image fixe", resa:"Instagram, Facebook", format:"Carrousel de 3 images", pilier:"Le produit et la conversion",
   texte:"Le Porc Noir de Bigorre ne ressemble à aucun autre cochon 🐖\n\nIl vit dehors, il grandit deux fois plus lentement qu'un porc ordinaire, et il finit sa vie dans les châtaigniers. C'est long, c'est exigeant, et c'est ce qui donne à sa viande un goût que l'on ne retrouve nulle part ailleurs.\n\nOn en fait un bouillon, mijoté doucement. Et jusqu'à épuisement du stock, on vous l'offre 🔥\n\nÀ partir de 80 € d'achat, le bocal à 15,90 € se glisse tout seul dans votre panier. Pas de code à saisir, rien à faire de plus.\n\nIl nous en reste 34. Quand il n'y en a plus, il n'y en a plus 🐗",
   tags:"#porcnoirdebigorre #bouillon #bouillonmaison #aop #hautespyrenees #produitlocal #artisanfrancais #racerustique #cuisinemaison #fondsdesauce #terroir #occitanie"},
  {id:"s2", date:"Jeudi 15 octobre, 18h30", titre:"24 heures de séchage - Reel", resa:"Instagram, TikTok, Facebook", format:"Reel, 24 secondes", pilier:"Le savoir-faire", audio:"Can't Stop, Bare Up",
   visuel:"Quatre plans : lamelles sur la grille vues de dessus, fermeture du déshydrateur, ouverture le lendemain, gros plan sur une lamelle qu'on plie.\nPas de parole, son d'ambiance, musique calme.\nTexte à l'écran : « 24 heures. C'est le temps qu'il faut. »",
   texte:"Vingt-quatre heures à cinquante degrés ⏳. Pas une minute de moins.\n\nC'est long. C'est lent. C'est ce qui fait la différence entre un jerky qui se mâche et un jerky qu'on oublie dans un tiroir.\n\nChez nous, pas de sucre ajouté, pas de conservateur, pas de raccourci. De la viande, du sel de Salies-de-Béarn, un peu de vinaigre de cidre, du temps 🔥.\n\nC'est tout. Et c'est déjà beaucoup 💪",
   tags:"#jerky #viandesechee #snackproteine #proteines #artisanfrancais #faitmaison #hautespyrenees #keto #carnivore #sansadditif #boeufseche #producteurlocal"},
  {id:"s5", date:"Vendredi 16 octobre, 18h30", titre:"Le snack d'après-séance - Reel", resa:"Instagram, TikTok, Facebook", format:"Reel, 15 à 25 secondes", pilier:"Les nouvelles cibles, sport et protéines",
   audio:"« Fashion week »",
   texte:"Dans le sac de sport, il y a toujours la même chose : une bouteille 🥤, une serviette, et un truc à grignoter… avec plus d'ingrédients qu'on ne peut faire de push-ups !\n\nLe jerky, c'est de la viande séchée, un peu de sel et de vinaigre de cidre, et rien d'autre. Riche en protéines (75 g pour 100 g) 💪, sans sucre, et ça se transporte très facilement 🎒",
   tags:"#proteines #snackproteine #jerky #musculation #crossfit #nutritionsportive #encassportif #sanssucreajoute #viandesechee #sportfrance #prisedemasse #postworkout"},
  {id:"s1", date:"Lundi 19 octobre, 12h30", titre:"On relance la conversation - Story", resa:"Instagram, stories", format:"3 écrans", pilier:"Les visages et la communauté",
   visuel:"Écran 1 : vidéo selfie de 10 secondes à l'atelier.\nÉcran 2 : plan large de l'atelier, avec un sondage.\nÉcran 3 : fond ocre uni, sticker questions.",
   demande:"Les plans vidéo des écrans 1 et 2 : une vidéo selfie de dix secondes à l'atelier, et un plan large de l'atelier.",
   texte:"Écran 1 : « On revient vers vous avec plein de nouveautés ce mois-ci. Mais d'abord, on a une question. »\nÉcran 2, sondage : « Vous nous suivez plutôt pour… » → Les jerkys et snacks / Les graisses et bouillons\nÉcran 3 : « Quel produit aimeriez-vous revoir en stock ? »", tags:""},
  {id:"s3", date:"Mardi 20 octobre, 18h30", titre:"Le jerky de sanglier - Carrousel", resa:"Instagram, Facebook", format:"Carrousel de 3 images", pilier:"Le produit et ses usages",
   texte:"Il y a celles et ceux qui s'arrêtent au bœuf... et il y a les autres 🐗.\n\nLe sanglier, c'est une viande de caractère. Maigre, dense, avec un goût qui ne s'excuse pas 💪. On la sèche lentement, comme tout le reste : du sel, un peu de vinaigre de cidre, du temps, rien d'autre.\n\nEt la texture va vous surprendre : ça croque comme un biscuit. De la viande sans en avoir l'air 😋\n\nSi vous cherchez un snack qui a du caractère, c'est par là. 10,90 € les 50 grammes, lien dans la bio\nEt vous, vous êtes plutôt classique ou aventurier·e ?",
   tags:"#jerky #viandesechee #sanglier #snackproteine #gibier #produitlocal #hautespyrenees #artisanfrancais #keto #carnivore #sansadditif #apero"},
  {id:"s4", date:"Mercredi 21 octobre, 12h30", titre:"Une journée à l'atelier - Story", resa:"Instagram, stories", format:"3 écrans", pilier:"Le savoir-faire",
   visuel:"Écran 1 : travelling lent sur les grilles chargées.\nÉcran 2 : mains qui disposent les lamelles, avec un curseur emoji.\nÉcran 3 : paquets alignés, avec le sticker lien vers la boutique.",
   demande:"Les rushes de l'atelier : travelling sur les grilles chargées, mains qui disposent les lamelles, paquets alignés prêts à partir.",
   texte:"Écran 1 : « Une journée à l'atelier. »\nÉcran 2 : « Chaque lamelle est posée à la main. » + curseur « Ça vous donne faim ? »\nÉcran 3 : « Et au bout, ça. »", tags:""},
  {id:"s8", date:"Mercredi 21 octobre, 18h30", titre:"Qui est derrière Sokarn - Carrousel", resa:"Instagram, Facebook", format:"Publication ou carrousel de 3", pilier:"Les visages et la communauté",
   visuel:"Portrait de Céline et Salomé à l'atelier, en situation de travail plutôt qu'en pose.\nEn carrousel : portrait, puis plan de l'atelier, puis gros plan des mains au travail.",
   demande:"Un portrait de vous deux à l'atelier en situation de travail, un plan de l'atelier, et un gros plan des mains au travail.",
   texte:"Derrière Sokarn, il y a deux femmes, un atelier dans les Hautes-Pyrénées 🏔️, et une conviction un peu têtue : on peut faire des snacks à base de viande sans sucre, sans additif et sans compromis.\n\nOn a commencé parce qu'on ne trouvait pas ce qu'on cherchait. Aujourd'hui, on sèche, on fume, on emballe, et on expédie dans toute la France 📦.\n\nChaque commande qui part d'ici a été préparée par l'une de nous deux.\n\nMerci d'être là ❤️",
   tags:"#artisanfrancais #femmesentrepreneurs #madeinfrance #hautespyrenees #produitlocal #savoirfaire #atelierartisanal #viandesechee #jerky #entrepreneuriat #occitanie #petiteentreprise"},
  {id:"s6", date:"Jeudi 22 octobre, 12h30", titre:"Vous avez voté - Story", resa:"Instagram, stories", format:"3 écrans", pilier:"La communauté",
   visuel:"Écran 1 : capture du sondage avec ses résultats.\nÉcran 2 : fond ocre avec le pourcentage obtenu.\nÉcran 3 : deux ou trois réponses reçues, en captures anonymisées.",
   texte:"Écran 1 : « Vous avez voté. »\nÉcran 2 : « Vous êtes X % à nous suivre pour les jerkys. Du coup, on vous en montre plus ce mois-ci. »\nÉcran 3 : « Message reçu. On y travaille. »", tags:""},
  {id:"s13", date:"Vendredi 23 octobre, 18h30", titre:"Le Sable Noir - Reel", resa:"Instagram, TikTok, Facebook", format:"Reel, 15 secondes", pilier:"Le produit et ses usages",
   visuel:"Vidéo produite par Manon à partir du produit que vous m'envoyez, avec des plans d'ambiance générés. Rien à filmer ni à photographier de votre côté.\nTextes à l'écran : « Besoin d'ajouter des protéines à vos soupes et salades ? », puis « Découvrez le Sable Noir ».",
   demande:"M'envoyer le produit Sable Noir, je m'occupe du reste.",
   texte:"On appelle ça le Sable Noir. C'est du graton de porc noir émietté, et c'est devenu notre condiment préféré 🖤\n\nSur une salade, sur des œufs brouillés, dans une soupe, sur une purée. Ça apporte du croustillant, un goût de cochon grillé, et 40 grammes de protéines pour 100 grammes 💪.\n\nSi vous ne deviez tester qu'un produit pour commencer, ce serait peut-être celui-là 👀",
   tags:"#proteines #condiment #grattons #porcnoirdebigorre #astucecuisine #keto #carnivore #recettefacile #croustillant #produitlocal #hautespyrenees #topping"},
  {id:"s11", date:"Samedi 24 octobre, 11h", titre:"Un seul produit pour tout l'automne - Story", resa:"Instagram, stories", format:"3 écrans", pilier:"Les visages",
   visuel:"Écran 1 : l'une de vous deux face caméra, 10 secondes.\nÉcran 2 : l'autre répond, 10 secondes. Un désaccord entre vous est idéal.\nÉcran 3 : fond ocre, sticker questions.",
   demande:"Vos deux réponses face caméra, dix secondes chacune. Un désaccord entre vous est idéal.",
   texte:"Écran 1 : « Question qu'on se pose souvent entre nous : si tu ne devais garder qu'un seul produit Sokarn pour tout l'automne, ce serait lequel ? »\nÉcran 2 : votre réponse et pourquoi.\nÉcran 3 : « Et vous ? »", tags:""},
  {id:"s12", date:"Lundi 26 octobre, 12h30", titre:"Vos réponses - Story", resa:"Instagram, stories", format:"3 écrans", pilier:"La communauté",
   visuel:"Écran 1 : rappel de la question posée samedi, puis trois réponses reçues, anonymisées.\nÉcran 2 : le Saindoux de Porc Noir de Bigorre en photo, avec le sticker lien vers sa fiche.\nÉcran 3 : l'Écorce de Porc Noir de Bigorre en photo, sticker lien vers sa fiche à poser au montage.",
   texte:"Écran 1 : « Vous avez été nombreuses et nombreux à répondre. » puis le rappel : « Si vous ne deviez garder qu'un seul produit Sokarn pour tout l'automne, ce serait lequel ? »\nÉcran 2 : « Le grand gagnant, c'est… Le Saindoux de Porc Noir de Bigorre. Cité dans une réponse sur trois. »\nÉcran 3 : « Vous avez aimé celui-là ? Alors vous aimerez sûrement… L'Écorce de Porc Noir de Bigorre. Le support idéal pour y étaler le saindoux. Votre idée, pas la nôtre. »", tags:""},
  {id:"s10", date:"Mardi 27 octobre, 18h30", titre:"Le Crêp'Karn - Reel", resa:"Instagram, TikTok, Facebook", format:"Reel, 20 à 30 secondes", pilier:"Le produit et ses usages",
   visuel:"Recette filmée en plan fixe au-dessus du plan de travail : poudre versée, œufs ajoutés, mélange, pâte dans la poêle, retournement, assiette finie.\nRythme rapide, musique entraînante.\nTextes à l'écran : « De la farine de viande », « En crêpes », « 71,5 g de protéines pour 100 g ».",
   demande:"Soit une vidéo de recette de crêpes que vous auriez déjà filmée, soit un envoi de Crêp'Karn pour que je filme la recette moi-même.",
   texte:"Une farine qui ne vient pas d'un champ 🌾\n\nLe Crêp'Karn, c'est de la viande déshydratée et réduite en poudre. On l'utilise comme une farine : crêpes, galettes, pancakes, liant pour une sauce.\n\nZéro glucide, 71,5 grammes de protéines pour 100 grammes 💪. Et c'est tout.\n\nLa recette complète est sur le site, dans la rubrique recettes. Et si vous l'avez déjà testée, racontez-nous en commentaire ce que vous en avez fait",
   tags:"#crepes #crepesproteinees #keto #carnivore #sansgluten #sanscereales #proteines #recettefacile #viandesechee #cuisinemaison #lowcarb #brunch"},
  {id:"s9", date:"Mercredi 28 octobre, 12h30", titre:"Ça se conserve combien de temps ? - Story", resa:"Instagram, stories", format:"4 écrans", pilier:"Le produit et ses usages",
   visuel:"Écran 1 : fond ocre, la question en gros.\nÉcran 2 : photo d'un paquet avec la réponse.\nÉcran 3 : plan du placard ou du sac.\nÉcran 4 : sticker questions.",
   texte:"Écran 1 : « Ça se conserve combien de temps ? »\nÉcran 2 : « Six mois après ouverture pour tous nos produits secs. »\nÉcran 3 : « Pas besoin de frigo. C'est tout l'intérêt du séchage. »\nÉcran 4 : « Une autre question sur nos produits ? »", tags:""},
  {id:"s14", date:"Mercredi 28 octobre, 18h30", titre:"La sélection d'Halloween - Carrousel", resa:"Instagram, Facebook", format:"Carrousel de 4 images", pilier:"Le produit, angle saisonnier",
   texte:"Tête en chips. Sang froid. Panse bête 🎃\n\nNon, ce ne sont pas des noms inventés pour Halloween. Ce sont nos produits, toute l'année.\n\nChez nous, on utilise l'animal entier. Ce qui part ailleurs à la poubelle devient ici un snack ♻️. C'est moins glamour que le filet, c'est tout aussi bon, et c'est surtout beaucoup plus respectueux de la bête.\n\nAlors pour une fois, nos noms sont de saison 🦇",
   tags:"#halloween #fromnosetotail #antigaspi #abats #viandesechee #snackoriginal #artisanfrancais #keto #carnivore #produitlocal #hautespyrenees #gastronomie"},
  {id:"s15", date:"Jeudi 29 octobre, 12h30", titre:"Les commandes de la semaine - Story", resa:"Instagram, stories", format:"3 écrans", pilier:"Les coulisses",
   visuel:"Écran 1 : colis alignés prêts à partir, vidéo courte.\nÉcran 2 : emballage d'une commande, mains au travail.\nÉcran 3 : colis fermé avec le logo, sticker lieu.",
   demande:"Les rushes d'expédition : colis alignés prêts à partir, emballage d'une commande, étiquette d'adresse.",
   texte:"Écran 1 : « Les commandes de la semaine. »\nÉcran 2 : « Chaque colis est préparé à la main, ici, dans les Hautes-Pyrénées. »\nÉcran 3 : « Direction toute la France. Et parfois plus loin. »", tags:""},
  {id:"s16", date:"Vendredi 30 octobre, 18h30", titre:"D'où vient la viande - Reel", resa:"Instagram, TikTok, Facebook", format:"Reel, 20 à 30 secondes", pilier:"Le savoir-faire",
   visuel:"Si un éleveur partenaire accepte : animaux en extérieur, échange avec l'éleveur, retour à l'atelier.\nSinon : viande fraîche à la découpe, main qui tranche, grille qui se remplit.\nTextes à l'écran : « On sait d'où vient notre viande », « Élevée ici, dans les Pyrénées », « Sauf celles qui ne vivent pas ici. On vous dit lesquelles. »",
   demande:"Les informations sur la provenance des viandes, et votre accord ou non pour mettre en avant un éleveur ou une éleveuse du coin en le ou la citant par son nom.",
   texte:"La question qu'on nous pose le plus souvent : d'où vient la viande ? 🐂\n\nRéponse : d'éleveuses et d'éleveurs qu'on connaît, à quelques kilomètres de l'atelier. Pas d'une centrale d'achat, pas d'un pays qu'on préfère ne pas nommer sur l'emballage.\n\nLes seules exceptions, ce sont les viandes qu'on ne trouve pas ici. Le kangourou ne court pas encore dans les Pyrénées 🦘.\n\nC'est plus cher à produire. C'est aussi la seule façon de faire qui nous intéresse 🏔️",
   tags:"#circuitcourt #producteurlocal #elevage #hautespyrenees #madeinfrance #artisanfrancais #tracabilite #viandesechee #occitanie #savoirfaire #keto #carnivore"},
  {id:"s17", date:"Samedi 31 octobre, 11h", titre:"Halloween et lancement de la newsletter - Story", resa:"Instagram, stories", format:"3 écrans", pilier:"La communauté et la conversion",
   visuel:"Écran 1 : l'autel d'Halloween.\nÉcran 2 : le sondage, Bigorr’eilles contre Panse bête. La Tête en chips, prévue au départ, est en rupture de stock : elle a été remplacée pour ne pas envoyer la tribu vers un produit introuvable.\nÉcran 3 : annonce de la newsletter, avec le code de bienvenue et le sticker lien vers le formulaire d'inscription.\nLes trois fonds sont prêts ci-dessous, il ne reste qu'à poser les stickers.",
   demande:"",
