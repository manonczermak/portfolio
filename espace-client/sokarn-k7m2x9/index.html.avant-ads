let retours = {};
let auteur = localStorage.getItem("mch-auteur") || "";
let deplies = new Set();

function esc(s){ return (s||"").replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;"); }

function erreur(msg){
  const e = document.getElementById("erreur");
  if (!msg) { e.style.display = "none"; return; }
  e.textContent = msg; e.style.display = "block";
}

async function charger(){
  try {
    const url = SB_URL + "/rest/v1/retours?projet=eq." + PROJET + "&periode=in.(" + PERIODE + "," + PERIODE_NOV + "," + PERIODE_WEB + "," + PERIODE_ELEM + "," + PERIODE_ADS + ")&select=*";
    const r = await fetch(url, { headers: { apikey: SB_KEY, Authorization: "Bearer " + SB_KEY } });
    if (!r.ok) throw new Error(r.status);
    const rows = await r.json();
    retours = {};
    rows.forEach(row => { retours[row.contenu_id] = row; });
    erreur("");
  } catch(e) {
    erreur("Impossible de charger les données enregistrées. Vérifiez votre connexion, puis rechargez la page.");
  }
  render(); renderNov(); renderElements(); renderTaches(); renderOffre(); renderAds(); renderNewsletter();
}

async function enregistrer(id, champs, el, periode){
  retours[id] = Object.assign({}, retours[id] || {}, champs);
  const corps = Object.assign({ projet: PROJET, periode: periode || PERIODE, contenu_id: id, auteur: auteur || null, maj: new Date().toISOString() }, champs);
  try {
    const r = await fetch(SB_URL + "/rest/v1/retours?on_conflict=projet,periode,contenu_id", {
      method: "POST",
      headers: { apikey: SB_KEY, Authorization: "Bearer " + SB_KEY, "Content-Type": "application/json", Prefer: "resolution=merge-duplicates,return=representation" },
      body: JSON.stringify(corps)
    });
    if (!r.ok) throw new Error(r.status);
    const rows = await r.json();
    if (rows && rows[0]) retours[id] = rows[0];
    erreur("");
    if (el) { el.classList.add("on"); setTimeout(() => el.classList.remove("on"), 1800); }
  } catch(e) {
    erreur("Votre dernière modification n'a pas pu être enregistrée. Vérifiez votre connexion et recommencez.");
  }
}

function dateFr(iso){
  if (!iso) return "";
  const d = new Date(iso);
  return d.toLocaleDateString("fr-FR", { day: "numeric", month: "long" }) + " à " + d.toLocaleTimeString("fr-FR", { hour: "2-digit", minute: "2-digit" });
}

function blocMedias(id){
  const f = MEDIAS[id] || [];
  if (!f.length) return `<div class="media-vide">Visuels à venir</div>`;
  const video = f.find(n => /\.(mp4|mov|webm)$/i.test(n));
  if (video) return `<div class="media-video"><video controls preload="metadata" src="medias/${esc(video)}"></video></div>`;
  return `<div class="medias">` + f.map((n, k) => `<button type="button" class="vignette" data-post="${esc(id)}" data-i="${k}" aria-label="Agrandir le visuel ${k + 1} sur ${f.length}"><img src="medias/${esc(n)}" alt="" loading="lazy"></button>`).join("") + `</div>`;
}

function rendu(LISTE, cid, periode, progressId, label){
  const c = document.getElementById(cid);
  if (!c) return;
  c.innerHTML = LISTE.map(p => {
    const r = retours[p.id] || {};
    const st = r.statut || "";
    const cls = st === "valide" ? " done" : (st === "revoir" ? " todo" : "");
    const pub = r.publication || "";
    const pubTxt = pub === "publie" ? "Publié" : (pub === "planifie" ? "Planifié" : "À planifier");
    const replie = (pub === "planifie" || pub === "publie") ? (deplies.has(p.id) ? " replie ouvert" : " replie") : "";
    const sign = (st || r.commentaire) && r.auteur ? `<div class="signature">${esc(r.auteur)}, le ${esc(dateFr(r.maj))}</div>` : "";
    return `
<article class="post${cls}${replie}" id="bloc-${p.id}">
  <div class="post-head">
    <div><div class="date">${esc(p.date)}</div><h3>${esc(p.titre)}</h3></div>
    <div class="meta">
      <span class="chip">${esc(p.resa)}</span>
      <span class="chip">${esc(p.format)}</span>
      <span class="chip">${esc(p.pilier)}</span>
      <span class="pub ${pub}">${pubTxt}</span>
    </div>
  </div>
  <div class="block"><div class="lab">Suivi de publication</div><select class="pubsel" data-pub="${p.id}"><option value="" ${pub===""?"selected":""}>À planifier</option><option value="planifie" ${pub==="planifie"?"selected":""}>Planifié</option><option value="publie" ${pub==="publie"?"selected":""}>Publié</option></select></div>
  ${replie ? `<button type="button" class="deplier" data-dep="${p.id}">${deplies.has(p.id) ? "Masquer le détail" : "Afficher le détail"}</button>` : ``}
  <div class="corps">
  ${p.attente ? `<div class="soon">En attente de votre décision sur l'option retenue.</div>` : ``}
  ${p.demande ? `<div class="soon"><b>De votre côté :</b> ${esc(p.demande)}</div>` : ``}
  ${p.visuel ? `<div class="block"><div class="lab">Visuel attendu</div><div class="val">${esc(p.visuel)}</div></div>` : ``}
  ${p.audio ? `<div class="block"><div class="lab">Son à appliquer sur Instagram</div><div class="val">${esc(p.audio)}</div></div>` : ``}
  <div class="block"><div class="lab">Visuels</div>${blocMedias(p.id)}</div>
  <div class="block"><div class="lab">Texte de publication</div><div class="caption">${esc(p.texte)}</div></div>
  ${p.tags ? `<div class="block"><div class="lab">Hashtags</div><div class="tags">${esc(p.tags)}</div></div>` : ``}
  <div class="review">
    <div class="choices">
      <label class="choice"><input type="radio" name="st-${p.id}" value="valide" ${st==="valide"?"checked":""}> Validé pour publication</label>
      <label class="choice"><input type="radio" name="st-${p.id}" value="revoir" ${st==="revoir"?"checked":""}> À revoir</label>
      <span class="saved" id="ok-${p.id}">Enregistré</span>
    </div>
    <textarea data-cm="${p.id}" placeholder="Vos remarques sur ce contenu">${esc(r.commentaire || "")}</textarea>
    ${sign}
    ${r.reponse ? `<div class="reply"><b>Réponse de Manon</b>${esc(r.reponse)}</div>` : ``}
    <div id="zone-rep-${p.id}"></div>
  </div>
  </div>
</article>`;
  }).join("");

  c.querySelectorAll('input[type=radio]').forEach(el => {
    el.addEventListener("change", async e => {
      const id = e.target.name.slice(3);
      await enregistrer(id, { statut: e.target.value }, document.getElementById("ok-" + id), periode);
      rendu(LISTE, cid, periode, progressId, label);
    });
  });
  c.querySelectorAll("button[data-dep]").forEach(b => {
    b.addEventListener("click", e => {
      const id = e.currentTarget.getAttribute("data-dep");
      if (deplies.has(id)) { deplies.delete(id); } else { deplies.add(id); }
      rendu(LISTE, cid, periode, progressId, label);
      const bloc = document.getElementById("bloc-" + id);
      if (bloc) bloc.scrollIntoView({ block: "nearest" });
    });
  });

  c.querySelectorAll('select[data-pub]').forEach(sel => {
    sel.addEventListener("change", async e => {
      const id = e.target.getAttribute("data-pub");
      await enregistrer(id, { publication: e.target.value }, document.getElementById("ok-" + id), periode);
      rendu(LISTE, cid, periode, progressId, label);
    });
  });
  c.querySelectorAll('textarea[data-cm]').forEach(t => {
    let timer;
    t.addEventListener("input", e => {
      const id = e.target.getAttribute("data-cm");
      clearTimeout(timer);
      timer = setTimeout(() => enregistrer(id, { commentaire: e.target.value }, document.getElementById("ok-" + id), periode), 900);
    });
  });

  zonesReponse(LISTE, periode);
  majCompteur(LISTE, progressId, label);
}

function render(){ rendu(POSTS, "posts", PERIODE, "progress", "Octobre : "); }
function renderNov(){ rendu(POSTS_NOV, "posts-nov", PERIODE_NOV, "progress-nov", ""); }

function zonesReponse(LISTE, periode){
  LISTE.forEach(p => {
    const z = document.getElementById("zone-rep-" + p.id);
    if (!z) return;
    const r = retours[p.id] || {};
    z.innerHTML = `<div style="margin-top:12px"><div class="lab">Votre réponse</div><textarea data-rep="${p.id}" placeholder="Répondre à ce retour">${esc(r.reponse || "")}</textarea></div>`;
    let timer;
    z.querySelector("textarea").addEventListener("input", e => {
      clearTimeout(timer);
      timer = setTimeout(() => enregistrer(p.id, { reponse: e.target.value }, document.getElementById("ok-" + p.id), periode), 900);
    });
  });
}

function renderElements(){
  const c = document.getElementById("elements");
  c.innerHTML = ELEMENTS.map(g => `
<div class="box">
  <h3>${esc(g.g)}</h3>
  ${g.note ? `<p style="margin:0 0 10px;font-size:15px;color:var(--ink-2)">${esc(g.note)}</p>` : ``}
  <ul class="cases">` + g.items.map(it => {
      const fait = (retours[it.id] || {}).statut === "fait";
      const lien = it.lien ? `<a class="lien-el" href="${esc(it.lien)}" target="_blank" rel="noopener">${esc(it.lienTexte || "Ouvrir le lien")}</a>` : ``;
      return `<li class="${fait ? "fait" : ""}"><label><input type="checkbox" data-el="${it.id}"${fait ? " checked" : ""}><span>${esc(it.t)}</span></label>${lien}</li>`;
    }).join("") + `</ul>
</div>`).join("");

  c.querySelectorAll("input[data-el]").forEach(el => {
    el.addEventListener("change", async e => {
      const id = e.target.getAttribute("data-el");
      await enregistrer(id, { statut: e.target.checked ? "fait" : "" }, null, PERIODE_ELEM);
      renderElements();
    });
  });

  const tous = ELEMENTS.flatMap(g => g.items);
  const faits = tous.filter(it => (retours[it.id] || {}).statut === "fait").length;
  document.getElementById("progress-elements").textContent = faits + " sur " + tous.length + " traités";
}

/* Suivi d'avancement : à faire, en cours, programmé / publié.
   Stocké dans la colonne "publication", comme pour les contenus. */
function selecteurEtat(id, troisieme){
  const e = (retours[id] || {}).publication || "";
  return `<div class="block"><div class="lab">Suivi d'avancement</div><select class="pubsel" data-etat="${id}"><option value="" ${e===""?"selected":""}>\u00c0 faire</option><option value="encours" ${e==="encours"?"selected":""}>En cours</option><option value="prog" ${e==="prog"?"selected":""}>${esc(troisieme)}</option></select> <span class="saved" id="ok-etat-${id}">Enregistr\u00e9</span></div>`;
}

function majPastille(id, spanId, troisieme){
  const sp = document.getElementById(spanId);
  if (!sp) return;
  const e = (retours[id] || {}).publication || "";
  sp.className = "pub" + (e ? " " + e : "");
  sp.textContent = e === "encours" ? "En cours" : (e === "prog" ? troisieme : "\u00c0 faire");
}

function brancherEtat(racine, periode, apres){
  racine.querySelectorAll("select[data-etat]").forEach(sel => {
    sel.addEventListener("change", async e => {
      const id = e.target.getAttribute("data-etat");
      await enregistrer(id, { publication: e.target.value }, document.getElementById("ok-etat-" + id), periode);
      apres();
    });
  });
}

function renderNewsletter(){
  const c = document.getElementById("nl-suivi");
  if (!c) return;
  const id = "nl-oct";
  const troisieme = "Programm\u00e9e / envoy\u00e9e";
  c.innerHTML = selecteurEtat(id, troisieme);
  majPastille(id, "etat-nl-oct", troisieme);
  brancherEtat(c, PERIODE_ADS, renderNewsletter);
}

function renderOffre(){
  const c = document.getElementById("offre-validation");
  if (!c) return;
  const id = "offre-bf";
  const r = retours[id] || {};
  const st = r.statut || "";
  const bloc = document.getElementById("bloc-offre");
  if (bloc) {
    bloc.classList.remove("done", "todo");
    if (st === "valide") bloc.classList.add("done");
    if (st === "revoir") bloc.classList.add("todo");
  }
  const sign = (st || r.commentaire) && r.auteur ? `<div class="signature">${esc(r.auteur)}, le ${esc(dateFr(r.maj))}</div>` : "";
  const troisieme = "Valid\u00e9e / en pr\u00e9paration";
  c.innerHTML = selecteurEtat(id, troisieme) + `
<div class="review">
  <div class="choices">
    <label class="choice"><input type="radio" name="st-offre" value="valide" ${st==="valide"?"checked":""}> Offre valid\u00e9e</label>
    <label class="choice"><input type="radio" name="st-offre" value="revoir" ${st==="revoir"?"checked":""}> \u00c0 revoir</label>
    <span class="saved" id="ok-offre">Enregistr\u00e9</span>
  </div>
  <textarea placeholder="Vos co\u00fbts de revient, vos stocks projet\u00e9s, vos remarques sur les paliers"></textarea>
  ${sign}
  ${r.reponse ? `<div class="reply"><b>R\u00e9ponse de Manon</b>${esc(r.reponse)}</div>` : ``}
</div>`;
  majPastille(id, "etat-offre", troisieme);
  brancherEtat(c, PERIODE_ADS, renderOffre);
  const ta = c.querySelector("textarea");
  ta.value = r.commentaire || "";
  c.querySelectorAll('input[type=radio]').forEach(el => {
    el.addEventListener("change", async e => {
      await enregistrer(id, { statut: e.target.value }, document.getElementById("ok-offre"), PERIODE_ADS);
      renderOffre();
    });
  });
  let timer;
  ta.addEventListener("input", e => {
    clearTimeout(timer);
    timer = setTimeout(() => enregistrer(id, { commentaire: e.target.value }, document.getElementById("ok-offre"), PERIODE_ADS), 900);
  });
}

function renderAds(){
  const c = document.getElementById("ads-validation");
  if (!c) return;
  const id = "ads-oct";
  const r = retours[id] || {};
  const st = r.statut || "";
  const bloc = document.getElementById("bloc-ads-oct");
  const etat = r.publication || "";
  const estReplie = (etat === "planifie" || etat === "prog");
  if (bloc) {
    bloc.classList.remove("done", "todo", "replie", "ouvert");
    if (st === "valide") bloc.classList.add("done");
    if (st === "revoir") bloc.classList.add("todo");
    if (estReplie) { bloc.classList.add("replie"); if (deplies.has(id)) bloc.classList.add("ouvert"); }
  }
  const sign = (st || r.commentaire) && r.auteur ? `<div class="signature">${esc(r.auteur)}, le ${esc(dateFr(r.maj))}</div>` : "";
  const troisieme = "Programm\u00e9e / en ligne";
  const bouton = estReplie ? `<button type="button" class="deplier" data-dep="${id}">${deplies.has(id) ? "Masquer le d\u00e9tail" : "Afficher le d\u00e9tail"}</button>` : ``;
  c.innerHTML = selecteurEtat(id, troisieme) + bouton + `
<div class="review">
  <div class="choices">
    <label class="choice"><input type="radio" name="st-ads" value="valide" ${st==="valide"?"checked":""}> Campagne valid\u00e9e</label>
    <label class="choice"><input type="radio" name="st-ads" value="revoir" ${st==="revoir"?"checked":""}> \u00c0 revoir</label>
    <span class="saved" id="ok-ads">Enregistr\u00e9</span>
  </div>
  <textarea data-cm-ads placeholder="Vos remarques sur cette campagne"></textarea>
  ${sign}
  ${r.reponse ? `<div class="reply"><b>R\u00e9ponse de Manon</b>${esc(r.reponse)}</div>` : ``}
</div>`;
  majPastille(id, "etat-ads-oct", troisieme);
  brancherEtat(c, PERIODE_ADS, renderAds);
  c.querySelectorAll("button[data-dep]").forEach(b => {
    b.addEventListener("click", e => {
      const k = e.currentTarget.getAttribute("data-dep");
      if (deplies.has(k)) { deplies.delete(k); } else { deplies.add(k); }
      renderAds();
    });
  });
  const ta = c.querySelector("textarea");
  ta.value = r.commentaire || "";
  c.querySelectorAll('input[type=radio]').forEach(el => {
    el.addEventListener("change", async e => {
      await enregistrer(id, { statut: e.target.value }, document.getElementById("ok-ads"), PERIODE_ADS);
      renderAds();
    });
  });
  let timer;
  ta.addEventListener("input", e => {
    clearTimeout(timer);
    timer = setTimeout(() => enregistrer(id, { commentaire: e.target.value }, document.getElementById("ok-ads"), PERIODE_ADS), 900);
  });
}

function renderTaches(){
  const c = document.getElementById("taches");
  c.innerHTML = TACHES.map(g => `
<div class="web-groupe">
  <h3>${esc(g.g)}</h3>
  ${g.items.map(it => {
    const r = retours[it.id] || {};
    const st = r.statut || "";
    const cls = st === "encours" ? " encours" : (st === "termine" ? " termine" : "");
    const sign = st && r.auteur ? ` · ${esc(r.auteur)}, le ${esc(dateFr(r.maj))}` : "";
    return `
  <div class="tache${cls}">
    <div class="txt">${esc(it.t)}<small>${esc(it.d)}${sign}</small></div>
    <div class="etats">
      <label class="etat"><input type="radio" name="w-${it.id}" value="ademarrer" ${st==="ademarrer"?"checked":""}> À démarrer</label>
      <label class="etat"><input type="radio" name="w-${it.id}" value="encours" ${st==="encours"?"checked":""}> En cours</label>
      <label class="etat"><input type="radio" name="w-${it.id}" value="termine" ${st==="termine"?"checked":""}> Terminé</label>
    </div>
  </div>`;
  }).join("")}
</div>`).join("");

  c.querySelectorAll('input[type=radio]').forEach(el => {
    el.addEventListener("change", async e => {
      const id = e.target.name.slice(2);
      await enregistrer(id, { statut: e.target.value }, null, PERIODE_WEB);
      renderTaches();
    });
  });

  const tous = TACHES.flatMap(g => g.items);
  const faits = tous.filter(it => retours[it.id] && retours[it.id].statut === "termine").length;
  document.getElementById("progress-web").textContent = faits + (faits > 1 ? " actions terminées sur " : " action terminée sur ") + tous.length;
}

function majCompteur(LISTE, progressId, label){
  const el = document.getElementById(progressId);
  if (!el) return;
  const n = LISTE.filter(p => retours[p.id] && retours[p.id].statut).length;
  el.textContent = (label || "") + n + (n > 1 ? " contenus traités sur " : " contenu traité sur ") + LISTE.length;
}

/* ---------- visionneuse ---------- */
const VISIO = { liste: [], i: 0, titre: "", retour: null };

function ouvrirVisio(id, i){
  const f = (MEDIAS[id] || []).filter(n => !/\.(mp4|mov|webm)$/i.test(n));
  if (!f.length) return;
  const p = POSTS.find(x => x.id === id);
  VISIO.liste = f;
  VISIO.i = Math.max(0, Math.min(i, f.length - 1));
  VISIO.titre = p ? p.titre : "";
  VISIO.retour = document.activeElement;
  document.getElementById("visio").classList.add("on");
  document.body.style.overflow = "hidden";
  majVisio();
  document.getElementById("visio-fermer").focus();
}

function majVisio(){
  const n = VISIO.liste.length;
  const img = document.getElementById("visio-img");
  img.src = "medias/" + VISIO.liste[VISIO.i];
  img.alt = "Visuel " + (VISIO.i + 1) + " sur " + n;
  document.getElementById("visio-titre").textContent = VISIO.titre + " — visuel " + (VISIO.i + 1) + " sur " + n;
  const aff = n > 1 ? "flex" : "none";
  document.getElementById("visio-prec").style.display = aff;
  document.getElementById("visio-suiv").style.display = aff;
  document.getElementById("visio-points").innerHTML = VISIO.liste.map((_, k) => '<i class="' + (k === VISIO.i ? "on" : "") + '"></i>').join("");
}

function deplacerVisio(d){
  const n = VISIO.liste.length;
  if (n < 2) return;
  VISIO.i = (VISIO.i + d + n) % n;
  majVisio();
}

function fermerVisio(){
  document.getElementById("visio").classList.remove("on");
  document.body.style.overflow = "";
  document.getElementById("visio-img").src = "";
  if (VISIO.retour && VISIO.retour.focus) VISIO.retour.focus();
}

document.getElementById("posts").addEventListener("click", e => {
  const b = e.target.closest("button.vignette");
  if (!b) return;
  ouvrirVisio(b.getAttribute("data-post"), parseInt(b.getAttribute("data-i"), 10));
});
document.getElementById("visio-fermer").addEventListener("click", fermerVisio);
document.getElementById("visio-prec").addEventListener("click", () => deplacerVisio(-1));
document.getElementById("visio-suiv").addEventListener("click", () => deplacerVisio(1));
document.getElementById("visio-corps").addEventListener("click", e => {
  if (e.target.id === "visio-corps") fermerVisio();
});
document.addEventListener("keydown", e => {
  if (!document.getElementById("visio").classList.contains("on")) return;
  if (e.key === "Escape") { e.preventDefault(); fermerVisio(); }
  else if (e.key === "ArrowRight") { e.preventDefault(); deplacerVisio(1); }
  else if (e.key === "ArrowLeft") { e.preventDefault(); deplacerVisio(-1); }
});
let visioX = null;
const visioCorps = document.getElementById("visio-corps");
visioCorps.addEventListener("touchstart", e => { visioX = e.changedTouches[0].clientX; }, { passive: true });
visioCorps.addEventListener("touchend", e => {
  if (visioX === null) return;
  const dx = e.changedTouches[0].clientX - visioX;
  if (Math.abs(dx) > 45) deplacerVisio(dx < 0 ? 1 : -1);
  visioX = null;
}, { passive: true });

charger();
setInterval(charger, 60000);
</script>

</body>
</html>
